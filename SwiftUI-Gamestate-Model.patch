+import SwiftUI
+
+struct RootView: View {
+    var body: some View {
+        TabView {
+            BattleView()
+                .tabItem {
+                    Label("Battle", systemImage: "shield.lefthalf.filled")
+                }
+
+            UpgradesView()
+                .tabItem {
+                    Label("Upgrades", systemImage: "wand.and.stars")
+                }
+        }
+        .accentColor(.accentGold)
+    }
+}
+
+struct BattleView: View {
+    @EnvironmentObject private var gameState: GameState
+
+    var body: some View {
+        ZStack {
+            LinearGradient(
+                colors: [.nightSky, .duskPurple],
+                startPoint: .top,
+                endPoint: .bottom
+            )
+            .ignoresSafeArea()
+
+            VStack(spacing: 24) {
+                Text("Eldertide Clash")
+                    .font(.system(.largeTitle, design: .serif))
+                    .foregroundColor(.accentGold)
+
+                VStack(spacing: 16) {
+                    CharacterCard(
+                        name: gameState.heroName,
+                        currentHP: gameState.heroHP,
+                        maxHP: gameState.heroMaxHP,
+                        tint: .heroGreen,
+                        icon: "person.fill"
+                    )
+
+                    CharacterCard(
+                        name: gameState.enemyName,
+                        currentHP: gameState.enemyHP,
+                        maxHP: gameState.enemyMaxHP,
+                        tint: .enemyRed,
+                        icon: "flame.fill"
+                    )
+                }
+
+                VStack(alignment: .leading, spacing: 12) {
+                    Text("Battle Log")
+                        .font(.system(.headline, design: .serif))
+                        .foregroundColor(.accentGold)
+
+                    Text(gameState.battleLog)
+                        .font(.system(.body, design: .serif))
+                        .foregroundColor(.white)
+                        .padding(16)
+                        .frame(maxWidth: .infinity, alignment: .leading)
+                        .background(Color.black.opacity(0.35))
+                        .clipShape(RoundedRectangle(cornerRadius: 16))
+                }
+
+                Spacer()
+            }
+            .padding(24)
+        }
+    }
+}
+
+struct UpgradesView: View {
+    @EnvironmentObject private var gameState: GameState
+
+    var body: some View {
+        ZStack {
+            LinearGradient(
+                colors: [.nightSky, .deepForest],
+                startPoint: .top,
+                endPoint: .bottom
+            )
+            .ignoresSafeArea()
+
+            VStack(spacing: 24) {
+                Text("Upgrades")
+                    .font(.system(.largeTitle, design: .serif))
+                    .foregroundColor(.accentGold)
+
+                UpgradeStatView(title: "Attack", value: gameState.attack, systemImage: "bolt.fill") {
+                    gameState.increaseAttack()
+                }
+
+                UpgradeStatView(title: "Defense", value: gameState.defense, systemImage: "shield.fill") {
+                    gameState.increaseDefense()
+                }
+
+                Spacer()
+            }
+            .padding(24)
+        }
+    }
+}
+
+private struct CharacterCard: View {
+    let name: String
+    let currentHP: Double
+    let maxHP: Double
+    let tint: Color
+    let icon: String
+
+    var body: some View {
+        VStack(alignment: .leading, spacing: 12) {
+            HStack {
+                Image(systemName: icon)
+                    .foregroundColor(tint)
+                    .font(.title2)
+
+                Text(name)
+                    .font(.system(.title3, design: .serif))
+                    .foregroundColor(.white)
+
+                Spacer()
+
+                Text("\(Int(currentHP))/\(Int(maxHP)) HP")
+                    .font(.system(.subheadline, design: .serif))
+                    .foregroundColor(.mistWhite)
+            }
+
+            ProgressView(value: currentHP, total: maxHP)
+                .tint(tint)
+                .scaleEffect(x: 1, y: 1.5, anchor: .center)
+        }
+        .padding(16)
+        .background(Color.black.opacity(0.35))
+        .clipShape(RoundedRectangle(cornerRadius: 16))
+    }
+}
+
+private struct UpgradeStatView: View {
+    let title: String
+    let value: Int
+    let systemImage: String
+    let action: () -> Void
+
+    var body: some View {
+        VStack(spacing: 16) {
+            HStack {
+                Image(systemName: systemImage)
+                    .foregroundColor(.accentGold)
+
+                Text(title)
+                    .font(.system(.title2, design: .serif))
+                    .foregroundColor(.white)
+
+                Spacer()
+
+                Text("\(value)")
+                    .font(.system(.title2, design: .serif))
+                    .foregroundColor(.mistWhite)
+            }
+
+            Button(action: action) {
+                Text("Increase \(title)")
+                    .font(.system(.headline, design: .serif))
+                    .foregroundColor(.black)
+                    .padding(.vertical, 12)
+                    .frame(maxWidth: .infinity)
+                    .background(Color.accentGold)
+                    .clipShape(RoundedRectangle(cornerRadius: 12))
+            }
+        }
+        .padding(20)
+        .background(Color.black.opacity(0.35))
+        .clipShape(RoundedRectangle(cornerRadius: 18))
+    }
+}
+
+#Preview {
+    RootView()
+        .environmentObject(GameState())
+}
