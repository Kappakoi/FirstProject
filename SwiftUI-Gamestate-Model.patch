+    static let deepForest = Color(red: 0.08, green: 0.2, blue: 0.16)
+    static let heroGreen = Color(red: 0.38, green: 0.78, blue: 0.5)
+    static let enemyRed = Color(red: 0.86, green: 0.35, blue: 0.35)
