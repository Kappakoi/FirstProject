new file mode 100644
index 0000000..ec0037f
--- /dev/null
+++ b/GameState.swift
@@ -0,0 +1,24 @@
+import SwiftUI
+
+final class GameState: ObservableObject {
+    @Published var heroName = "Aria the Bold"
+    @Published var enemyName = "Gloomfang"
+    @Published var heroHP: Double = 74
+    @Published var heroMaxHP: Double = 100
+    @Published var enemyHP: Double = 46
+    @Published var enemyMaxHP: Double = 80
+    @Published var battleLog = "Aria raises her blade, the cavern glows with runes."
+
+    @Published var attack: Int = 12
+    @Published var defense: Int = 8
+
+    func increaseAttack() {
+        attack += 1
+        battleLog = "Aria sharpens her edge. Attack rises to \(attack)."
+    }
+
+    func increaseDefense() {
+        defense += 1
+        battleLog = "Aria fortifies her stance. Defense rises to \(defense)."
+    }
+}
