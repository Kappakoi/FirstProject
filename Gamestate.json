+import SwiftUI
+
+struct ContentView: View {
+    @EnvironmentObject private var store: GameStateStore
+
+    var body: some View {
+        VStack(spacing: 16) {
+            Text("Stage \(store.state.currentStage)")
+                .font(.title)
+            Text("HP \(store.state.heroStats.health)")
+            Text("Attack \(store.state.heroStats.attack)")
+            Text("Defense \(store.state.heroStats.defense)")
+            Text("Gold \(store.state.currency)")
+        }
+        .padding()
+    }
+}
+
+#Preview {
+    ContentView()
+        .environmentObject(GameStateStore())
+}
diff --git a/FirstProjectApp.swift b/FirstProjectApp.swift
new file mode 100644
index 0000000..379dd78
--- /dev/null
+++ b/FirstProjectApp.swift
@@ -0,0 +1,23 @@
+import SwiftUI
+import UIKit
+
+@main
+struct FirstProjectApp: App {
+    @Environment(\.scenePhase) private var scenePhase
+    @StateObject private var store = GameStateStore()
+
+    var body: some Scene {
+        WindowGroup {
+            ContentView()
+                .environmentObject(store)
+                .onReceive(NotificationCenter.default.publisher(for: UIApplication.willTerminateNotification)) { _ in
+                    store.save()
+                }
+        }
+        .onChange(of: scenePhase) { newPhase in
+            if newPhase == .background || newPhase == .inactive {
+                store.save()
+            }
+        }
+    }
+}
