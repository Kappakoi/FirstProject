@@ -0,0 +1,19 @@
+import Foundation
+
+struct HeroStats: Codable, Equatable {
+    var health: Int
+    var attack: Int
+    var defense: Int
+}
+
+struct GameState: Codable, Equatable {
+    var heroStats: HeroStats
+    var currency: Int
+    var currentStage: Int
+
+    static let `default` = GameState(
+        heroStats: HeroStats(health: 100, attack: 10, defense: 5),
+        currency: 0,
+        currentStage: 1
+    )
+}
diff --git a/GameStateStorage.swift b/GameStateStorage.swift
new file mode 100644
index 0000000..8bb7bd9
--- /dev/null
+++ b/GameStateStorage.swift
@@ -0,0 +1,49 @@
+import Foundation
+
+struct GameStateStorage {
+    private let fileName = "GameState.json"
+    private let userDefaultsKey = "GameState"
+
+    func load() -> GameState? {
+        if let fileData = readFromDisk(),
+           let state = try? JSONDecoder().decode(GameState.self, from: fileData) {
+            return state
+        }
+
+        if let defaultsData = UserDefaults.standard.data(forKey: userDefaultsKey),
+           let state = try? JSONDecoder().decode(GameState.self, from: defaultsData) {
+            return state
+        }
+
+        return nil
+    }
+
+    func save(_ state: GameState) {
+        guard let data = try? JSONEncoder().encode(state) else {
+            return
+        }
+
+        writeToDisk(data)
+        UserDefaults.standard.set(data, forKey: userDefaultsKey)
+    }
+
+    private func readFromDisk() -> Data? {
+        guard let url = fileURL() else {
+            return nil
+        }
+
+        return try? Data(contentsOf: url)
+    }
+
+    private func writeToDisk(_ data: Data) {
+        guard let url = fileURL() else {
+            return
+        }
+
+        try? data.write(to: url, options: .atomic)
+    }
+
+    private func fileURL() -> URL? {
+        FileManager.default.urls(for: .documentDirectory, in: .userDomainMask).first?.appendingPathComponent(fileName)
+    }
+}
diff --git a/GameStateStore.swift b/GameStateStore.swift
new file mode 100644
index 0000000..a6201c7
--- /dev/null
+++ b/GameStateStore.swift
@@ -0,0 +1,14 @@
+import SwiftUI
+
+final class GameStateStore: ObservableObject {
+    @Published var state: GameState
+    private let storage = GameStateStorage()
+
+    init() {
+        state = storage.load() ?? .default
+    }
+
+    func save() {
+        storage.save(state)
+    }
+}
