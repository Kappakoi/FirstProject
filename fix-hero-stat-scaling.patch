+import Foundation
+
+public struct HeroBaseStats: Codable, Equatable {
+    public var attack: Int
+    public var defense: Int
+    public var health: Int
+
+    public func scaled(for level: Int) -> HeroStats {
+        HeroStats(
+            attack: attack + (level - 1) * 2,
+            defense: defense + (level - 1),
+            health: health + (level - 1) * 5
+        )
+    }
+}
+
+public struct HeroStats: Codable, Equatable {
+    public var attack: Int
+    public var defense: Int
+    public var health: Int
+}
+
+public struct HeroProgress: Codable, Equatable {
+    public var level: Int
+    public var experience: Int
+    public var gold: Int
+    public var baseStats: HeroBaseStats
+
+    public var currentStats: HeroStats {
+        baseStats.scaled(for: level)
+    }
+
+    public static let starter = HeroProgress(
+        level: 1,
+        experience: 0,
+        gold: 0,
+        baseStats: HeroBaseStats(attack: 10, defense: 5, health: 100)
+    )
+}
+
+public struct GameState: Codable, Equatable {
+    public var hero: HeroProgress
+    public var lastActiveAt: Date
+
+    public static let fresh = GameState(hero: .starter, lastActiveAt: Date())
+}
+
+public final class GameEngine {
+    public static let shared = GameEngine()
+
+    private static let storageKey = "FirstProject.GameState"
+    private static let lastActiveKey = "FirstProject.LastActiveAt"
+    private let userDefaults: UserDefaults
+
+    public var state: GameState
+
+    public let battleInterval: TimeInterval = 15
+    public let experiencePerBattle: Int = 6
+    public let goldPerBattle: Int = 4
+    public let maxOfflineDuration: TimeInterval = 8 * 60 * 60
+
+    public init(userDefaults: UserDefaults = .standard) {
+        self.userDefaults = userDefaults
+        self.state = Self.loadState(from: userDefaults) ?? .fresh
+        if let lastActive = userDefaults.object(forKey: Self.lastActiveKey) as? Date {
+            self.state.lastActiveAt = lastActive
+        }
+    }
+
+    public func handleAppLaunch(now: Date = Date()) {
+        simulateOfflineProgress(now: now)
+        updateLastActive(now: now)
+    }
+
+    public func updateLastActive(now: Date = Date()) {
+        state.lastActiveAt = now
+        userDefaults.set(now, forKey: Self.lastActiveKey)
+        saveState()
+    }
+
+    public func simulateOfflineProgress(now: Date = Date()) {
+        let elapsed = max(0, now.timeIntervalSince(state.lastActiveAt))
+        let cappedElapsed = min(elapsed, maxOfflineDuration)
+        let battleCount = Int(floor(cappedElapsed / battleInterval))
+        guard battleCount > 0 else {
+            return
+        }
+
+        let totalExperience = battleCount * experiencePerBattle
+        let totalGold = battleCount * goldPerBattle
+
+        state.hero.gold += totalGold
+        applyExperience(totalExperience)
+        saveState()
+    }
+
+    private func applyExperience(_ amount: Int) {
+        guard amount > 0 else { return }
+
+        state.hero.experience += amount
+        while state.hero.experience >= experienceNeeded(for: state.hero.level + 1) {
+            levelUp()
+        }
+    }
+
+    private func levelUp() {
+        state.hero.level += 1
+    }
+
+    private func experienceNeeded(for level: Int) -> Int {
+        20 + (level - 1) * 10
+    }
+
+    private func saveState() {
+        guard let data = try? JSONEncoder().encode(state) else { return }
+        userDefaults.set(data, forKey: Self.storageKey)
+    }
+
+    private static func loadState(from defaults: UserDefaults) -> GameState? {
+        guard let data = defaults.data(forKey: Self.storageKey) else { return nil }
+        return try? JSONDecoder().decode(GameState.self, from: data)
+    }
+}
