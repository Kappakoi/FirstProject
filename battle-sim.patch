@@ -0,0 +1,27 @@
+import XCTest
+@testable import BattleSim
+
+final class BattleEngineTests: XCTestCase {
+    func testTickResolvesInSpeedOrder() {
+        let fastHero = Hero(name: "Swift", stats: CombatStats(hp: 10, attack: 5, defense: 1, speed: 9))
+        let slowEnemy = Enemy(kind: .goblin, stats: CombatStats(hp: 10, attack: 4, defense: 1, speed: 2))
+        let engine = BattleEngine(heroes: [fastHero], enemies: [slowEnemy])
+
+        engine.tick()
+
+        XCTAssertEqual(engine.lastTickOrder, ["Swift", "Goblin"])
+        XCTAssertLessThan(slowEnemy.stats.hp, 10)
+    }
+
+    func testBattleEndsWhenEnemiesDefeated() {
+        let hero = Hero(name: "Aria", stats: CombatStats(hp: 30, attack: 20, defense: 4, speed: 7))
+        let enemy = EnemyTemplates.goblin()
+        let engine = BattleEngine(heroes: [hero], enemies: [enemy])
+
+        while !engine.isBattleOver {
+            engine.tick()
+        }
+
+        XCTAssertTrue(enemy.stats.hp == 0)
+    }
+}
