+import Foundation
+
+public struct CombatStats: Equatable {
+    public var hp: Int
+    public let attack: Int
+    public let defense: Int
+    public let speed: Int
+
+    public init(hp: Int, attack: Int, defense: Int, speed: Int) {
+        self.hp = hp
+        self.attack = attack
+        self.defense = defense
+        self.speed = speed
+    }
+}
+
+public protocol Combatant: AnyObject {
+    var name: String { get }
+    var stats: CombatStats { get set }
+    var isAlive: Bool { get }
+    func takeTurn(in engine: BattleEngine)
+}
+
+public extension Combatant {
+    var isAlive: Bool { stats.hp > 0 }
+}
+
+public final class Hero: Combatant {
+    public let name: String
+    public var stats: CombatStats
+
+    public init(name: String, stats: CombatStats) {
+        self.name = name
+        self.stats = stats
+    }
+
+    public func takeTurn(in engine: BattleEngine) {
+        guard let target = engine.firstLivingEnemy() else { return }
+        engine.applyAttack(from: self, to: target)
+    }
+}
+
+public final class Enemy: Combatant {
+    public enum Kind: String {
+        case goblin = "Goblin"
+        case skeleton = "Skeleton"
+    }
+
+    public let name: String
+    public let kind: Kind
+    public var stats: CombatStats
+
+    public init(kind: Kind, stats: CombatStats) {
+        self.kind = kind
+        self.name = kind.rawValue
+        self.stats = stats
+    }
+
+    public func takeTurn(in engine: BattleEngine) {
+        guard let target = engine.firstLivingHero() else { return }
+        engine.applyAttack(from: self, to: target)
+    }
+}
