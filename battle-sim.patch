@@ -0,0 +1,42 @@
+import Foundation
+
+public final class BattleEngine {
+    public private(set) var heroes: [Hero]
+    public private(set) var enemies: [Enemy]
+    public private(set) var lastTickOrder: [String] = []
+
+    public init(heroes: [Hero], enemies: [Enemy]) {
+        self.heroes = heroes
+        self.enemies = enemies
+    }
+
+    public func tick() {
+        guard !isBattleOver else { return }
+        let combatants: [Combatant] = (heroes as [Combatant]) + (enemies as [Combatant])
+        let ordered = combatants
+            .filter { $0.isAlive }
+            .sorted { $0.stats.speed > $1.stats.speed }
+        lastTickOrder = ordered.map { $0.name }
+        for combatant in ordered {
+            guard !isBattleOver else { break }
+            combatant.takeTurn(in: self)
+        }
+    }
+
+    public var isBattleOver: Bool {
+        heroes.allSatisfy { !$0.isAlive } || enemies.allSatisfy { !$0.isAlive }
+    }
+
+    public func firstLivingHero() -> Hero? {
+        heroes.first(where: { $0.isAlive })
+    }
+
+    public func firstLivingEnemy() -> Enemy? {
+        enemies.first(where: { $0.isAlive })
+    }
+
+    public func applyAttack(from attacker: Combatant, to defender: Combatant) {
+        let damage = max(1, attacker.stats.attack - defender.stats.defense)
+        defender.stats.hp = max(0, defender.stats.hp - damage)
+    }
+}
diff --git a/Sources/BattleSim/Entities.swift b/Sources/BattleSim/Entities.swift
