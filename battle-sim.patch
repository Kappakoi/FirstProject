@@ -0,0 +1,21 @@
+import Foundation
+
+public final class HeadlessBattleRunner {
+    private let engine: BattleEngine
+    private let loop: GameLoop
+
+    public init(engine: BattleEngine, interval: TimeInterval = 1.0) {
+        self.engine = engine
+        self.loop = GameLoop(interval: interval) { [weak engine] _ in
+            engine?.tick()
+        }
+    }
+
+    public func start() {
+        loop.start()
+    }
+
+    public func stop() {
+        loop.stop()
+    }
+}
